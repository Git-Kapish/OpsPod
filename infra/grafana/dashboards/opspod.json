    "h": 7,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(opspod_cases_total{route=\"ESCALATE\"}[15m])) / sum(rate(opspod_cases_total[15m]))",
     "legendFormat": "escalated",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
